# Copy to .env and edit:  cp .env.example .env
#
# Every variable here has a working default in docker-compose.yml, so an empty
# .env still brings up the control plane. The ones that matter are marked
# REQUIRED below -- the stack runs without them, but not usefully.

# The build id baked into every image. Compose cannot run `git describe`
# itself, so pass it in:
#
#   VERSION=$(git describe --tags --always --dirty) docker compose build
#
# Left unset, every binary reports `version=unknown`, which is at least honest
# but tells you nothing about which build is running.
VERSION=unknown

# --- secrets -----------------------------------------------------------------

# Signs the JWTs. The default is a placeholder that is in this repository, so
# anything reachable from outside your machine needs a real value:
#
#   openssl rand -hex 32
#
JWT_SECRET=change-me-before-you-expose-this

RABBITMQ_USER=surr
RABBITMQ_PASSWORD=surr

MONGO_USER=root
MONGO_PASSWORD=root
MONGO_DB=nodes

# The data plane does not run as root. mongo-init creates both of these on every
# `up` (see deploy/mongo-init.js): the node gets readWrite because it creates
# its own timeseries collection and inserts into it, the analytics service gets
# read because that is all a query needs. Change a password here and the next
# `up` updates the account rather than keeping the old one.
#
# Both accounts are created in MONGO_DB, not in `admin`, so their MONGO_URLs pass
# authSource=<MONGO_DB> -- a URL that names no database makes the driver
# authenticate against `admin` and fail. Renaming MONGO_DB here re-creates the
# users in the new database on the next `up`, and the URLs follow.
MONGO_NODES_USER=surr-writer
MONGO_NODES_PASSWORD=surr
MONGO_ANALYTICS_USER=surr-reader
MONGO_ANALYTICS_PASSWORD=surr

# --- host port mappings ------------------------------------------------------

HUB_HTTP_PORT=9000
RABBITMQ_MANAGEMENT_PORT=15672
RX_INGRESS_PORT=4200
RX_EGRESS_PORT=4201

# The refresh cookie is Secure by default, which a plain-HTTP stack cannot
# satisfy. Leave this false for local use and set it true (or terminate TLS in
# front of the hub) before exposing it.
HUB_COOKIE_SECURE=false

# --- tx (profile: tx) --------------------------------------------------------

# REQUIRED to start tx. The id returned by POST /subscriptions/add.
TX_SUBSCRIPTION_ID=

# REQUIRED to start tx, unless you are running mediamtx on the compose network
# publishing cam1 -- which is what the `demo` profile does, and why this
# default works out of the box:
#
#   docker compose --profile demo --profile tx --profile nodes up -d
#
# See README.md for the other two ways to get an RTSP source.
TX_SRC=rtsp://mediamtx:8554/cam1

# --- demo source (profile: demo) ---------------------------------------------

# The synthetic camera. It publishes to rtsp://mediamtx:8554/cam1 by default,
# which is exactly what TX_SRC above expects, so these only need changing if
# you want a different resolution or a second stream.
DEMO_WIDTH=1280
DEMO_HEIGHT=720
DEMO_FPS=30
DEMO_PATH=cam1

TX_NAME=cam1
TX_DOWNSTREAM=1280,720,300

# --- bustle node (profile: nodes) -------------------------------------------

# This id is the node's handle everywhere: the hub's nodes table, the
# subscription's node list, and the `<node-id>.sink.*` commands. Change it and
# the node registers as a different node.
BUSTLE_NODE_ID=50154422-fd3b-4cf0-a761-908fcbe98a1e
BUSTLE_NODE_NAME=bustle0

# COCO class ids to count. 0,1,2,3 is person, bicycle, car, motorcycle.
BUSTLE_CLASSES=0,1,2,3
